{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "macro-app/user-food-data.schema.json",
  "title": "User Food Data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "foods",
    "retiredServingIds"
  ],
  "properties": {
    "foods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/foodServings"
      }
    },
    "retiredServingIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "foodServings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "foodId",
        "servings"
      ],
      "properties": {
        "foodId": {
          "type": "string",
          "minLength": 1
        },
        "servings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/serving"
          }
        }
      }
    },
    "serving": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "grams",
        "approximate",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "grams": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "approximate": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
