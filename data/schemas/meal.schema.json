{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "macro-app/meal.schema.json",
  "title": "Meal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "source",
    "ingredients"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "library",
        "saved",
        "external"
      ]
    },
    "mealType": {
      "enum": [
        "breakfast",
        "lunch",
        "snack",
        "dinner",
        "other"
      ]
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "foodId",
          "quantity",
          "unit"
        ],
        "properties": {
          "foodId": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "favorite": {
      "type": "boolean"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
